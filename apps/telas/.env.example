NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...SUA_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...SUA_SERVICE_ROLE_KEY_AQUI

# URL da aplicação
NEXT_PUBLIC_APP_URL=https://telas.cyberinformatica.tech

# Resend (email transacional)
RESEND_API_KEY=re_SUA_API_KEY
