# ============================================
# Cyber Informática · Landing Page B2B
# ============================================
# Copie este arquivo para .env.local e preencha os valores reais
# cp .env.example .env.local
# ============================================

# Supabase (Settings → API no dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...SUA_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...SUA_SERVICE_ROLE_KEY_AQUI

# URL da aplicação
NEXT_PUBLIC_APP_URL=https://telas.cyberinformatica.tech

# Resend (email transacional)
RESEND_API_KEY=re_SUA_API_KEY
RESEND_FROM_EMAIL=noreply@cyberinformatica.tech

# Admin (primeiro usuário)
NEXT_PUBLIC_ADMIN_EMAIL=contato@cyberinformatica.tech

# Google Analytics 4 (opcional — sem isso o gtag.js não carrega)
NEXT_PUBLIC_GA4_ID=

# Meta (Facebook) Pixel + API de Conversões
# - Pixel ID: Gerenciador de Eventos → Configurações do conjunto de dados
# - Token CAPI: Gerenciador de Eventos → Configurações → "Gerar token de acesso"
# Sem esses valores, o Pixel/CAPI ficam inertes (não carregam).
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
